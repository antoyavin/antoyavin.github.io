---
layout: base.njk
---

<article class="post-article">
  <header class="post-header">
    <h1>{{ title }}</h1>
    <time class="post-date" datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>
    {% if tags %}
    <div class="post-tags">
      {% for tag in tags %}
      <span class="post-tag">{{ tag }}</span>
      {% endfor %}
    </div>
    {% endif %}
  </header>
  <div class="post-body">
    {{ content | safe }}
  </div>
</article>
